    $sql = "SELECT COUNT(*) as total_rows FROM users WHERE role='teacher'";
    $result = mysqli_query($conn, $sql);
    $teachers = mysqli_fetch_assoc($result);

    $sql_1 = "SELECT COUNT(*) as total_row FROM users WHERE role='student'";
    $result1 = mysqli_query($conn, $sql_1);
    $students = mysqli_fetch_assoc($result1);

    $sql_2 = "SELECT COUNT(*) as admin_count FROM users WHERE role='admin'";
    $result2 = mysqli_query($conn, $sql_2);
    $admins = mysqli_fetch_assoc($result2);

    $sql_3 = "SELECT COUNT(*) as parent_count FROM parent";
    $result3 = mysqli_query($conn, $sql_3);
    $parents = mysqli_fetch_assoc($result3);
